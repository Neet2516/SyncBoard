# Server Configuration
PORT=6000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database & Cache
MONGO_URI=mongodb://localhost:27017/syncboard
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=syncboard

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
BCRYPT_SALT_ROUNDS=12
AUTH_COOKIE_NAME=syncboard_session

# Auth Time-To-Live (TTL) Settings (in seconds)
AUTH_SESSION_TTL_SECONDS=604800
AUTH_USER_CACHE_TTL_SECONDS=300
TEMP_AUTH_STATE_TTL_SECONDS=600

# Rate Limiting
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=600

# Email SMTP Settings
EMAIL_FROM=your_email@gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FAMILY=4
